{
  "病药": {
    "source": "神峰通考·病药说",
    "quote": "有病方为贵，无伤不是奇；格中如去病，财禄两相随。",
    "applies_to": "取用",
    "rules": [
      {
        "name": "定病",
        "when": [
          "全盘最旺一行领先次旺者不低于 bing_margin 倍",
          "身弱时不以日主本行为病"
        ],
        "then": "该行为病"
      },
      {
        "name": "定药",
        "when": [
          "病已定"
        ],
        "then": "克病者为药，以之为用"
      },
      {
        "name": "不作病论",
        "when": [
          "最旺与次旺咬得很近（未达 bing_margin）"
        ],
        "then": "不判病——压得不明显就不是病，免得权重微动就换出相反的药"
      }
    ],
    "thresholds": {
      "bing_margin": {
        "value": 1.1,
        "from": "本包取值，可调"
      }
    },
    "chapter": "病药说类"
  }
}
